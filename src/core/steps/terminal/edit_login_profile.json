{
  "checks": {
    "unix": [
      "test ! -f ~/.bashrc || grep -q \"workstation1_v$WS_VERSION\" ~/.bashrc",
      "test ! -f ~/.zshrc || grep -q \"workstation1_v$WS_VERSION\" ~/.zshrc"
    ],
    "win": [
      "(Get-Content -Path $PROFILE.CurrentUserCurrentHost -Raw) -match \"workstation1_v$WS_VERSION\""
    ]
  }
}
